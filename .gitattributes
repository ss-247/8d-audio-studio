# Normalize line endings to LF in the repo, checkout as-is on Windows
* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf

# Treat audio/binary assets as binary (no diff, no merging)
*.wav binary
*.mp3 binary
*.flac binary
*.ogg binary
*.sofa binary
*.sf2 binary
